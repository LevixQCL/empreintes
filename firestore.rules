rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Chaque joueur ne lit et n'écrit que sa propre sauvegarde.
    // (lecture, écriture et suppression séparées : request.resource n'existe pas à la lecture)
    match /saves/{uid} {
      allow get, delete: if request.auth != null && request.auth.uid == uid;
      // l'outil d'analyse (analyse.html, 25 octobre 2026) : lecture seule de toutes les sauvegardes, pour un seul compte Google
      allow get, list: if estAdmin();
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['data', 'updatedAt', 'version'])
        // 3 novembre 2026 : la partie est un texte de moins de 900 000 caractères, la version un nombre entier
        && request.resource.data.data is string && request.resource.data.data.size() < 900000
        && request.resource.data.version is int;
    }

    // Le Grand Tableau (23 octobre 2026) : tout directeur connecté lit les classements, chacun n'écrit que sa propre entrée.
    // Elle ne s'efface plus (3 novembre 2026) : effacer puis recréer contournait « la profondeur ne redescend jamais
    // et monte de deux Strates au plus par publication ».
    // Les scores sont calculés sur l'appareil : ces règles bloquent les erreurs et la triche grossière
    // (champs inconnus, valeurs impossibles, profondeur qui redescend, publications en rafale).
    // Le jour du multijoueur, les Cloud Functions recalculeront les scores à partir de la sauvegarde.
    match /classement/{uid} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == uid && entreeValide(request.resource.data);
      allow update: if request.auth != null && request.auth.uid == uid && entreeValide(request.resource.data)
        // la profondeur ne redescend jamais, et ne gagne pas plus de deux Strates d'un coup
        && request.resource.data.profondeur >= resource.data.profondeur
        && request.resource.data.profondeur <= resource.data.profondeur + 4
        // la date d'arrivée ne bouge que si la profondeur monte, et c'est alors maintenant : « premier arrivé » ne se falsifie pas
        && ((request.resource.data.profondeur > resource.data.profondeur && maintenant(request.resource.data.profondeurLe))
            || (request.resource.data.profondeur == resource.data.profondeur && request.resource.data.profondeurLe == resource.data.profondeurLe))
        // la Flèche, pareil : le record ne redescend jamais, gagne au plus 12 quais d'un coup, et sa date n'est « maintenant » que s'il monte
        && request.resource.data.get('fleche', 0) >= resource.data.get('fleche', 0)
        && request.resource.data.get('fleche', 0) <= resource.data.get('fleche', 0) + 12
        && ((request.resource.data.get('fleche', 0) > resource.data.get('fleche', 0) && maintenant(request.resource.data.get('flecheLe', 0)))
            || (request.resource.data.get('fleche', 0) == resource.data.get('fleche', 0) && request.resource.data.get('flecheLe', 0) == resource.data.get('flecheLe', 0)))
        // les Joutes ne redescendent jamais et gagnent au plus 3 d'un coup
        && request.resource.data.get('joutes', 0) >= resource.data.get('joutes', 0)
        && request.resource.data.get('joutes', 0) <= resource.data.get('joutes', 0) + 3
        && request.resource.data.maj >= resource.data.maj + 20000;
    }

    // Les pseudos (23 octobre 2026) : une fiche par pseudo, à un seul compte. Deux joueurs ne peuvent pas avoir le même :
    // la fiche existe déjà, la création est refusée. La clé est le pseudo en minuscules, sans accents ni séparateurs
    // (« Bryan », « bryan », « Bryän » et « B-ryan » sont le même), et elle doit correspondre exactement au nom.
    match /pseudos/{cle} {
      allow get: if request.auth != null;
      allow create: if request.auth != null && pseudoValide(cle, request.resource.data)
        && request.resource.data.uid == request.auth.uid && maintenant(request.resource.data.le);
      allow update: if request.auth != null && resource.data.uid == request.auth.uid && pseudoValide(cle, request.resource.data)
        && request.resource.data.uid == resource.data.uid && request.resource.data.le == resource.data.le;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    // Les pillages (26 octobre 2026) : chaque directeur publie sa garnison (son escouade, ses cartes, son coffre) ;
    // tout directeur connecté les lit pour trouver des archipels à sa portée. Un pillage joué contre lui est noté
    // dans garnisons/{uid}/subis par l'attaquant ; seul le défenseur les efface. Les bornes limitent la triche :
    // une victoire prend au plus un dixième du coffre publié, et le défenseur n'applique que 3 attaques par jour,
    // avec 8 h de bouclier après une attaque perdue (src/core/partie/pillages.ts, subirPillages).
    match /garnisons/{uid} {
      allow read: if request.auth != null;
      allow delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid && garnisonValide(request.resource.data);
      match /subis/{id} {
        allow read: if request.auth != null;
        allow delete: if request.auth != null && request.auth.uid == uid;
        // 3 novembre 2026 : l'identifiant est « attaquant_demi-journée » (src/net/pillages.ts) : une attaque notée par attaquant,
        // par défenseur et par demi-journée (la précédente ou la suivante tolérée pour une horloge un peu décalée) ; plus de rafales
        allow create: if request.auth != null && request.auth.uid != uid && subiValide(request.resource.data, uid)
          && id in [request.auth.uid + '_' + string(demiJournee() - 1), request.auth.uid + '_' + string(demiJournee()), request.auth.uid + '_' + string(demiJournee() + 1)];
      }
    }

    // La Flèche (29 octobre 2026, src/net/fleche.ts) : le directeur qui tient un quai publie sa garnison figée dans
    // quais/{uid} ; celui qui le défie note le défi dans quais/{uid}/assauts (sur le quai réellement tenu). Un défi gagné
    // porte l'identifiant « attaquant_installation » : il autorise le vainqueur à effacer la fiche du battu, qui disparaît
    // aussitôt de la Flèche. Le gardien applique lui-même les défis subis (subirAssauts) et efface les anciens.
    match /quais/{uid} {
      allow read: if request.auth != null;
      allow delete: if request.auth != null && (request.auth.uid == uid
        || get(/databases/$(database)/documents/quais/$(uid)/assauts/$(request.auth.uid + '_' + string(resource.data.depuis))).data.victoire == true);
      allow create, update: if request.auth != null && request.auth.uid == uid && quaiValide(request.resource.data);
      match /assauts/{id} {
        allow read: if request.auth != null;
        allow delete: if request.auth != null && request.auth.uid == uid;
        allow create: if request.auth != null && request.auth.uid != uid && assautValide(request.resource.data, uid)
          && (!request.resource.data.victoire || (id == request.auth.uid + '_' + string(get(/databases/$(database)/documents/quais/$(uid)).data.depuis)
            // une victoire (qui déloge le gardien) n'est possible que sur un quai que l'attaquant a déjà atteint dans son
            // classement (3 novembre 2026 : avant, n'importe quel compte pouvait déloger n'importe quel gardien)
            && get(/databases/$(database)/documents/classement/$(request.auth.uid)).data.get('fleche', 0) >= request.resource.data.quai));
      }
    }

    // Le parrainage (29 octobre 2026, src/net/parrainage.ts) : `parrains/{code}` dit à qui est un code (une fiche par code,
    // comme les pseudos) ; `recrues/{uid}` est créée une seule fois par le filleul (un seul parrain, définitif, jamais soi-même),
    // et ses paliers ne font que s'ajouter. Le parrain lit ses recrues avec une requête sur son uid.
    match /parrains/{code} {
      allow get: if request.auth != null;
      allow create: if request.auth != null && code.matches('^[A-Z2-9]{6}$') && parrainValide(request.resource.data)
        && request.resource.data.uid == request.auth.uid && maintenant(request.resource.data.le);
      allow update: if request.auth != null && resource.data.uid == request.auth.uid && parrainValide(request.resource.data)
        && request.resource.data.uid == resource.data.uid && request.resource.data.le == resource.data.le;
    }
    match /recrues/{uid} {
      allow get: if request.auth != null && (request.auth.uid == uid || resource.data.parrain == request.auth.uid);
      allow list: if request.auth != null && resource.data.parrain == request.auth.uid;
      allow create: if request.auth != null && request.auth.uid == uid && recrueValide(request.resource.data)
        && request.resource.data.parrain != uid
        && request.resource.data.paliers.size() == 0
        && maintenant(request.resource.data.le) && request.resource.data.maj == request.resource.data.le
        && get(/databases/$(database)/documents/parrains/$(request.resource.data.code)).data.uid == request.resource.data.parrain;
      allow update: if request.auth != null && request.auth.uid == uid && recrueValide(request.resource.data)
        && request.resource.data.parrain == resource.data.parrain && request.resource.data.code == resource.data.code
        && request.resource.data.le == resource.data.le
        && request.resource.data.paliers.hasAll(resource.data.paliers)
        && maintenant(request.resource.data.maj)
        // chaque nouveau palier doit se voir dans le classement du filleul, et pas trop tôt après son arrivée
        // (3 novembre 2026 : avant, le filleul déclarait ses paliers sans contrôle ; un second compte suffisait)
        && palierPermis('strate1', uid, 3, 300000)
        && palierPermis('strate3', uid, 6, 3600000)
        && palierPermis('noyau3', uid, 2, 3600000);
    }

    // Le Cercle des quais (3 novembre 2026, src/net/cercle.ts) : vitrines, amitiés, échanges de cartes et défis en duel.
    // La vitrine d'un directeur se lit par tout directeur connecté (pour l'ajouter en ami et voir ses doubles), chacun n'écrit que la sienne.
    match /profils/{uid} {
      allow get: if request.auth != null;
      allow create, update: if request.auth != null && request.auth.uid == uid && profilValide(request.resource.data, uid);
      allow delete: if request.auth != null && request.auth.uid == uid;
    }
    // Une amitié : l'identifiant est fait des deux uid triés ; demandée par l'un, acceptée par l'autre, défaite par l'un ou l'autre.
    match /amities/{id} {
      // lire une fiche précise (même absente : on vérifie avant de demander) ; lister seulement les siennes
      allow get: if request.auth != null && request.auth.uid in id.split('_');
      allow list: if request.auth != null && request.auth.uid in resource.data.membres;
      allow create: if request.auth != null && amitieValide(request.resource.data, id)
        && request.resource.data.de == request.auth.uid && request.resource.data.etat == 'attente'
        && maintenant(request.resource.data.le);
      allow update: if request.auth != null && resource.data.a == request.auth.uid && resource.data.etat == 'attente'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['etat', 'depuis'])
        && request.resource.data.etat == 'ok' && maintenant(request.resource.data.depuis);
      allow delete: if request.auth != null && request.auth.uid in resource.data.membres;
    }
    // Une proposition d'échange : seulement entre amis depuis au moins 3 jours, deux cartes du même métal (le suffixe « @métal »).
    // Le destinataire accepte ou refuse, l'auteur peut annuler ; une seule réponse, tant qu'elle est proposée.
    match /echanges/{id} {
      allow read: if request.auth != null && (resource.data.de == request.auth.uid || resource.data.a == request.auth.uid);
      allow create: if request.auth != null && propositionValide(request.resource.data, id)
        && request.resource.data.de == request.auth.uid && request.resource.data.etat == 'propose'
        && maintenant(request.resource.data.le) && request.resource.data.maj == request.resource.data.le
        && amisDepuis(request.auth.uid, request.resource.data.a, 259200000);
      allow update: if request.auth != null && resource.data.etat == 'propose'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['etat', 'maj']) && maintenant(request.resource.data.maj)
        && ((resource.data.a == request.auth.uid && request.resource.data.etat in ['accepte', 'refuse'])
          || (resource.data.de == request.auth.uid && request.resource.data.etat == 'annule'));
      allow delete: if request.auth != null && (resource.data.de == request.auth.uid
        || (resource.data.a == request.auth.uid && resource.data.etat != 'propose'));
    }
    // Un défi en duel envoyé à un ami : le code du salon (duels/{code}) et le mode (libre, ou à armes égales).
    match /defis/{id} {
      allow read: if request.auth != null && (resource.data.de == request.auth.uid || resource.data.a == request.auth.uid);
      allow create: if request.auth != null && defiValide(request.resource.data, id) && request.resource.data.de == request.auth.uid
        && request.resource.data.etat == 'envoye' && maintenant(request.resource.data.le)
        && amisDepuis(request.auth.uid, request.resource.data.a, 0);
      allow update: if request.auth != null && resource.data.a == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['etat']) && request.resource.data.etat in ['accepte', 'refuse'];
      allow delete: if request.auth != null && (resource.data.de == request.auth.uid || resource.data.a == request.auth.uid);
    }

    // Le duel en temps réel (docs/duel.md) : le code du salon fait office de secret
    match /duels/{code} {
      allow get: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.hote.uid == request.auth.uid
        && request.resource.data.etat == 'attente'
        && code.size() == 6;
      // rejoindre (une seule fois), puis finir ou abandonner : seulement les deux joueurs
      allow update: if request.auth != null && (
        (resource.data.etat == 'attente' && !('invite' in resource.data)
          && request.resource.data.invite.uid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['invite', 'etat', 'debut', 'maj']))
        || ((resource.data.hote.uid == request.auth.uid || resource.data.invite.uid == request.auth.uid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['etat', 'gagnant', 'abandon', 'maj'])));
      match /choix/{id} {
        allow read: if request.auth != null
          && request.auth.uid in [get(/databases/$(database)/documents/duels/$(code)).data.hote.uid,
                                  get(/databases/$(database)/documents/duels/$(code)).data.invite.uid];
        allow create: if request.auth != null && request.resource.data.uid == request.auth.uid
          && request.resource.data.keys().hasOnly(['uid', 'tour', 'camp', 'sceau', 'le'])
          && id == string(request.resource.data.tour) + '-' + string(request.resource.data.camp);
        // révéler : seulement son choix, une seule fois, sans toucher au sceau
        allow update: if request.auth != null && resource.data.uid == request.auth.uid
          && !('choix' in resource.data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['choix', 'sel']);
      }
    }

    function profilValide(d, uid) {
      return d.keys().hasOnly(['uid', 'nom', 'cle', 'strate', 'porteur', 'vitrine', 'doubles', 'souhaits', 'cercle', 'victoires', 'maj'])
        && d.uid == uid
        && d.nom is string && d.nom.size() >= 3 && d.nom.size() <= 18
        && d.cle is string && get(/databases/$(database)/documents/pseudos/$(d.cle)).data.uid == uid
        && d.strate is int && d.strate >= 1 && d.strate <= 200
        && d.porteur is string && d.porteur.size() <= 24
        && d.vitrine is list && d.vitrine.size() <= 3
        && d.doubles is list && d.doubles.size() <= 400
        && d.souhaits is list && d.souhaits.size() <= 30
        && d.cercle is int && d.cercle >= 0 && d.cercle <= 10
        && d.victoires is int && d.victoires >= 0
        && maintenant(d.maj);
    }

    function amitieValide(d, id) {
      return d.keys().hasOnly(['id', 'membres', 'de', 'a', 'nomDe', 'nomA', 'etat', 'le'])
        && d.id == id && d.membres is list && d.membres.size() == 2 && d.membres[0] < d.membres[1]
        && id == d.membres[0] + '_' + d.membres[1]
        && d.de in d.membres && d.a in d.membres && d.de != d.a
        && d.nomDe is string && d.nomDe.size() <= 24 && d.nomA is string && d.nomA.size() <= 24;
    }

    // deux directeurs amis depuis au moins `delai` ms
    function amisDepuis(x, y, delai) {
      let a = get(/databases/$(database)/documents/amities/$(x < y ? x + '_' + y : y + '_' + x)).data;
      return a.etat == 'ok' && a.depuis + delai <= request.time.toMillis();
    }

    function propositionValide(d, id) {
      return d.keys().hasOnly(['id', 'de', 'a', 'nomDe', 'nomA', 'donne', 'demande', 'etat', 'le', 'maj'])
        && d.id == id && d.a is string && d.a != d.de
        && d.nomDe is string && d.nomDe.size() <= 24 && d.nomA is string && d.nomA.size() <= 24
        && d.donne is string && d.donne.size() <= 60 && d.demande is string && d.demande.size() <= 60
        && d.donne != d.demande
        && d.donne.split('@').size() == 2 && d.demande.split('@').size() == 2
        && d.donne.split('@')[1] == d.demande.split('@')[1]
        && d.donne.split('@')[1] in ['fer', 'cuivre', 'argent', 'or'];
    }

    function defiValide(d, id) {
      return d.keys().hasOnly(['id', 'de', 'a', 'nomDe', 'code', 'mode', 'etat', 'le'])
        && d.id == id && d.a is string && d.a != d.de
        && d.nomDe is string && d.nomDe.size() <= 24
        && d.code is string && d.code.size() == 6
        && d.mode in ['libre', 'egal'];
    }

    // un palier déjà publié reste acquis ; un nouveau demande une profondeur (en demi-étages, voir profondeurDe dans
    // src/core/classements.ts : −1 vaincue = 3, −3 ouverte = 6) et un délai minimal depuis l'arrivée du filleul (ms)
    function palierPermis(p, uid, profondeur, delai) {
      return !(p in request.resource.data.paliers) || (p in resource.data.paliers)
        || (get(/databases/$(database)/documents/classement/$(uid)).data.profondeur >= profondeur
          && request.time.toMillis() >= resource.data.le + delai);
    }

    function parrainValide(d) {
      return d.keys().hasOnly(['uid', 'nom', 'le']) && d.uid is string && d.le is int
        && d.nom is string && d.nom.size() >= 1 && d.nom.size() <= 24;
    }

    function recrueValide(d) {
      return d.keys().hasOnly(['parrain', 'code', 'nom', 'paliers', 'le', 'maj'])
        && d.parrain is string && d.code is string && d.code.matches('^[A-Z2-9]{6}$')
        && d.nom is string && d.nom.size() >= 1 && d.nom.size() <= 24
        && d.paliers is list && d.paliers.size() <= 3 && d.paliers.hasOnly(['strate1', 'strate3', 'noyau3'])
        && d.le is int && d.maj is int;
    }

    function garnisonValide(d) {
      return d.keys().hasOnly(['nom', 'porteurs', 'strate', 'coffre', 'force', 'maj'])
        && d.nom is string && d.nom.size() >= 1 && d.nom.size() <= 24
        && d.porteurs is list && d.porteurs.size() >= 1 && d.porteurs.size() <= 3
        && d.strate is int && d.strate >= 1 && d.strate <= 200
        && d.coffre is int && d.coffre >= 0 && d.coffre <= 1000000
        && d.force is number && d.force > 0 && d.force < 1000
        && maintenant(d.maj);
    }

    function quaiValide(d) {
      return d.keys().hasOnly(['nom', 'quai', 'force', 'porteurs', 'depuis', 'maj'])
        && d.nom is string && d.nom.size() >= 1 && d.nom.size() <= 24
        && d.quai is int && d.quai >= 2 && d.quai <= 100
        && d.force is number && d.force > 0 && d.force < 1000
        && d.porteurs is list && d.porteurs.size() == 3
        && d.depuis is int && d.depuis <= request.time.toMillis() + 300000
        && maintenant(d.maj);
    }

    function assautValide(d, gardien) {
      return d.keys().hasOnly(['attaquant', 'nom', 'quai', 'victoire', 'le'])
        && d.attaquant == request.auth.uid
        && d.nom is string && d.nom.size() >= 1 && d.nom.size() <= 24
        && d.victoire is bool
        && d.quai == get(/databases/$(database)/documents/quais/$(gardien)).data.quai
        && maintenant(d.le);
    }

    function subiValide(d, defenseur) {
      return d.keys().hasOnly(['attaquant', 'nom', 'victoire', 'vol', 'perte', 'le'])
        && d.attaquant == request.auth.uid
        && d.nom is string && d.nom.size() >= 1 && d.nom.size() <= 24
        && d.victoire is bool
        && d.vol is int && d.vol >= 0
        && d.vol <= get(/databases/$(database)/documents/garnisons/$(defenseur)).data.coffre / 10 + 1
        && d.perte is int && d.perte >= 0 && d.perte <= 100000
        // une victoire ne laisse rien, une défaite ne prend rien
        && (d.victoire || d.vol == 0) && (!d.victoire || d.perte == 0)
        && maintenant(d.le);
    }

    function estAdmin() {
      return request.auth != null && request.auth.token.email == 'houben.bryan@gmail.com' && request.auth.token.email_verified == true;
    }

    function pseudoValide(cle, d) {
      return d.keys().hasOnly(['uid', 'nom', 'le']) && d.uid is string && d.le is int
        && d.nom is string && d.nom.size() >= 3 && d.nom.size() <= 18
        && cle.matches('^[a-z0-9]{3,24}$') && clePseudo(d.nom) == cle;
    }

    // la même table que clePseudo dans src/core/classements.ts
    function clePseudo(nom) {
      return nom.lower().replace("[ .'’_-]", "")
        .replace("[àáâãäå]", "a").replace("[èéêë]", "e").replace("[ìíîï]", "i").replace("[òóôõöø]", "o").replace("[ùúûü]", "u")
        .replace("[ýÿ]", "y").replace("ç", "c").replace("ñ", "n").replace("œ", "oe").replace("æ", "ae").replace("ß", "ss");
    }

    function entreeValide(d) {
      return d.keys().hasOnly(['nom', 'cle', 'porteur', 'profondeur', 'profondeurLe', 'registre', 'decouvertes',
          'semaine', 'profondeurSemaine', 'registreSemaine', 'fleche', 'flecheLe', 'flecheSemaine', 'joutes', 'joutesSemaine', 'insigne', 'masque', 'maj'])
        && d.nom is string && d.nom.size() >= 3 && d.nom.size() <= 18
        // le pseudo affiché est bien celui que ce joueur a réservé
        && d.cle is string && d.cle.size() <= 24
        && getAfter(/databases/$(database)/documents/pseudos/$(d.cle)).data.uid == request.auth.uid
        && getAfter(/databases/$(database)/documents/pseudos/$(d.cle)).data.nom == d.nom
        && d.porteur is string && d.porteur.size() <= 24
        && d.profondeur is int && d.profondeur >= 2 && d.profondeur <= 201
        && d.profondeurLe is int
        && d.registre is int && d.registre >= 0 && d.registre <= 2000000
        && d.decouvertes is int && d.decouvertes >= 0 && d.decouvertes <= 500
        && d.semaine is int
        && d.profondeurSemaine is int && d.profondeurSemaine >= 0 && d.profondeurSemaine <= d.profondeur
        && d.registreSemaine is int && d.registreSemaine >= 0 && d.registreSemaine <= d.registre
        // la Flèche (28 octobre 2026) : absente des anciennes entrées, sinon un quai entre 0 et 101
        && d.get('fleche', 0) is int && d.get('fleche', 0) >= 0 && d.get('fleche', 0) <= 101
        && d.get('flecheLe', 0) is int
        && d.get('flecheSemaine', 0) is int && d.get('flecheSemaine', 0) >= 0 && d.get('flecheSemaine', 0) <= d.get('fleche', 0)
        // les Joutes du Cercle (3 novembre 2026) : absentes des anciennes entrées
        && d.get('joutes', 0) is int && d.get('joutes', 0) >= 0 && d.get('joutes', 0) <= 100000
        && d.get('joutesSemaine', 0) is int && d.get('joutesSemaine', 0) >= 0 && d.get('joutesSemaine', 0) <= 3
        // le titre « Recruteur » du parrainage (29 octobre 2026) : absent, ou ce seul mot
        && d.get('insigne', 'recruteur') == 'recruteur'
        // « me retirer du Tableau » (3 novembre 2026) : l'entrée est masquée au lieu d'être effacée
        && d.get('masque', false) is bool
        && d.maj is int && maintenant(d.maj);
    }

    // le numéro de la demi-journée en cours (heure du serveur)
    function demiJournee() {
      return math.floor(request.time.toMillis() / 43200000);
    }

    // une heure en millisecondes à cinq minutes près de l'heure du serveur
    function maintenant(ms) {
      return ms is int && ms <= request.time.toMillis() + 300000 && ms >= request.time.toMillis() - 300000;
    }

    // Tout le reste est fermé par défaut.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
